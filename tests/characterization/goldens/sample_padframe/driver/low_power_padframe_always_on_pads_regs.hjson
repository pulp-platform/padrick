            },
          ]
      }

       {
          name: PAD_GPIOC14_MUX_SEL
          desc: '''
              Pad signal port multiplex selection for pad pad_gpioc14. The programmed value defines which port
              is connected to the pad.
          '''
          swaccess: "rw"
          hwaccess: "hro"
          resval: 1
          fields: [
              {
                  bits: "0:0"
                  enum: [
                      { value: "0", name: "register", desc: "Connects the Pad to the internal configuration register."}
                      { value: "1", name: "port_gpio_c_gpioc14", desc: "Connect port GPIOC14 from port group gpio_c to this pad." }
                  ]
              }
          ]
      }

      {
          name: PAD_GPIOC15_CFG
          desc: '''
            Pad signal configuration.
          '''
          swaccess: "rw"
          fields: [
            {
                bits: "0"
                name: chip2pad
                desc: '''
                     The signal that connects to the pads TX driver
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "1"
            },
            {
                bits: "1"
                name: output_en
                desc: '''
                     Enables the output driver of the pad
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "2"
                name: pull_up_en
                desc: '''
                     Enable the pads weak pull-up resistor
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "3"
                name: rx_en
                desc: '''
                     Input buffer enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
          ]
      }

       {
          name: PAD_GPIOC15_MUX_SEL
          desc: '''
              Pad signal port multiplex selection for pad pad_gpioc15. The programmed value defines which port
              is connected to the pad.
          '''
          swaccess: "rw"
          hwaccess: "hro"
          resval: 1
          fields: [
              {
                  bits: "0:0"
                  enum: [
                      { value: "0", name: "register", desc: "Connects the Pad to the internal configuration register."}
                      { value: "1", name: "port_gpio_c_gpioc15", desc: "Connect port GPIOC15 from port group gpio_c to this pad." }
                  ]
              }
          ]
      }

    ]
}
