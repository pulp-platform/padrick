

{
    name: "low_power_padframe_always_on_pads_config"
    clock_primary: "clk_i"
    reset_primary: "rst_ni"
    bus_interfaces: [
        { protocol: "reg_iface", direction: "device"}
    ]
    regwidth: 32,
    registers: [
        {skipto: "0x0"},
        {
            name: INFO
            desc: "Read-only IP Information register"
            swaccess: "ro"
            hwaccess: "hro"
            fields: [
              {
                bits: "15:0"
                name: HW_VERSION
                desc: "Hardware version ID."
                resval: 2
              },
              {
                  bits:"31:16"
                  name: PADCOUNT
                  desc: "The number of muxable pads in this IP."
                  resval: "80"
              }
            ]
        }

      {
          name: PAD_GPIOA0_CFG
          desc: '''
            Pad signal configuration.
          '''
          swaccess: "rw"
          fields: [
            {
                bits: "0"
                name: chip2pad
                desc: '''
                     The signal that connects to the pads TX driver
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "1"
            },
            {
                bits: "1"
                name: output_en
                desc: '''
                     Enables the output driver of the pad
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "2"
                name: pull_up_en
                desc: '''
                     Enable the pads weak pull-up resistor
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "3"
                name: rx_en
                desc: '''
                     Input buffer enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
          ]
      }

       {
          name: PAD_GPIOA0_MUX_SEL
          desc: '''
              Pad signal port multiplex selection for pad pad_gpioa0. The programmed value defines which port
              is connected to the pad.
          '''
          swaccess: "rw"
          hwaccess: "hro"
          resval: 5
          fields: [
              {
                  bits: "2:0"
                  enum: [
                      { value: "0", name: "register", desc: "Connects the Pad to the internal configuration register."}
                      { value: "1", name: "port_gpio_a_gpio00", desc: "Connect port GPIO00 from port group gpio_a to this pad." }
                      { value: "2", name: "port_spi_csn", desc: "Connect port csn from port group spi to this pad." }
                      { value: "3", name: "port_spi_miso", desc: "Connect port miso from port group spi to this pad." }
                      { value: "4", name: "port_spi_mosi", desc: "Connect port mosi from port group spi to this pad." }
                      { value: "5", name: "port_spi_sck", desc: "Connect port sck from port group spi to this pad." }
                  ]
              }
          ]
      }

      {
          name: PAD_GPIOA1_CFG
          desc: '''
            Pad signal configuration.
