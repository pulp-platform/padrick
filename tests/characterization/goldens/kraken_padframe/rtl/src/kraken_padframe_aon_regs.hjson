

{
    name: "kraken_padframe_aon_config"
    clock_primary: "clk_i"
    reset_primary: "rst_ni"
    bus_interfaces: [
        { protocol: "reg_iface", direction: "device"}
    ]
    regwidth: 32,
    registers: [
        {skipto: "0x0"},
        {
            name: INFO
            desc: "Read-only IP Information register"
            swaccess: "ro"
            hwaccess: "hro"
            fields: [
              {
                bits: "15:0"
                name: HW_VERSION
                desc: "Hardware version ID."
                resval: 2
              },
              {
                  bits:"31:16"
                  name: PADCOUNT
                  desc: "The number of muxable pads in this IP."
                  resval: "42"
              }
            ]
        }



























      {
          name: PAD_GPIOA0_CFG
          desc: '''
            Pad signal configuration.
          '''
          swaccess: "rw"
          fields: [
            {
                bits: "0"
                name: chip2pad
                desc: '''
                     The signal that connects to the pads TX driver
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "2:1"
                name: drv
                desc: '''
                     Driving strength selector
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "3"
            },
            {
                bits: "3"
                name: pde
                desc: '''
                     Pull down resistor enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "4"
                name: pue
                desc: '''
                     Pull up resistor enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "5"
                name: rxe
                desc: '''
                     Active high RX driver enable 
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "1"
            },
            {
                bits: "6"
                name: slw
                desc: '''
                     
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "7"
                name: smt
                desc: '''
                     Schmit trigger enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "8"
                name: trie
                desc: '''
                      Active high tri-state enable (active low TX driver enable)
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "1"
            },
          ]
      }

       {
          name: PAD_GPIOA0_MUX_SEL
          desc: '''
              Pad signal port multiplex selection for pad pad_gpioa0. The programmed value defines which port
              is connected to the pad.
          '''
          swaccess: "rw"
          hwaccess: "hro"
          resval: 0
          fields: [
              {
                  name: sel
                  desc: "Port selection index for pad pad_gpioa0."
                  bits: "5:0"
                  enum: [
                      { value: "0", name: "register", desc: "Connects the Pad to the internal configuration register."}
                      { value: "1", name: "port_dvsi0_are", desc: "Connect port are from port group dvsi0 to this pad." }
                      { value: "2", name: "port_dvsi0_asa", desc: "Connect port asa from port group dvsi0 to this pad." }
                      { value: "3", name: "port_dvsi0_asy", desc: "Connect port asy from port group dvsi0 to this pad." }
                      { value: "4", name: "port_dvsi0_cfg0", desc: "Connect port cfg0 from port group dvsi0 to this pad." }
                      { value: "5", name: "port_dvsi0_cfg1", desc: "Connect port cfg1 from port group dvsi0 to this pad." }
                      { value: "6", name: "port_dvsi0_cfg2", desc: "Connect port cfg2 from port group dvsi0 to this pad." }
                      { value: "7", name: "port_dvsi0_cfg3", desc: "Connect port cfg3 from port group dvsi0 to this pad." }
                      { value: "8", name: "port_dvsi0_cfg4", desc: "Connect port cfg4 from port group dvsi0 to this pad." }
                      { value: "9", name: "port_dvsi0_cfg5", desc: "Connect port cfg5 from port group dvsi0 to this pad." }
                      { value: "10", name: "port_dvsi0_cfg6", desc: "Connect port cfg6 from port group dvsi0 to this pad." }
                      { value: "11", name: "port_dvsi0_cfg7", desc: "Connect port cfg7 from port group dvsi0 to this pad." }
                      { value: "12", name: "port_dvsi0_off0", desc: "Connect port off0 from port group dvsi0 to this pad." }
                      { value: "13", name: "port_dvsi0_off1", desc: "Connect port off1 from port group dvsi0 to this pad." }
                      { value: "14", name: "port_dvsi0_off2", desc: "Connect port off2 from port group dvsi0 to this pad." }
                      { value: "15", name: "port_dvsi0_off3", desc: "Connect port off3 from port group dvsi0 to this pad." }
                      { value: "16", name: "port_dvsi0_on0", desc: "Connect port on0 from port group dvsi0 to this pad." }
                      { value: "17", name: "port_dvsi0_on1", desc: "Connect port on1 from port group dvsi0 to this pad." }
                      { value: "18", name: "port_dvsi0_on2", desc: "Connect port on2 from port group dvsi0 to this pad." }
                      { value: "19", name: "port_dvsi0_on3", desc: "Connect port on3 from port group dvsi0 to this pad." }
                      { value: "20", name: "port_dvsi0_sxy", desc: "Connect port sxy from port group dvsi0 to this pad." }
                      { value: "21", name: "port_dvsi0_xclk", desc: "Connect port xclk from port group dvsi0 to this pad." }
                      { value: "22", name: "port_dvsi0_xnrst", desc: "Connect port xnrst from port group dvsi0 to this pad." }
                      { value: "23", name: "port_dvsi0_xydata0", desc: "Connect port xydata0 from port group dvsi0 to this pad." }
                      { value: "24", name: "port_dvsi0_xydata1", desc: "Connect port xydata1 from port group dvsi0 to this pad." }
                      { value: "25", name: "port_dvsi0_xydata2", desc: "Connect port xydata2 from port group dvsi0 to this pad." }
                      { value: "26", name: "port_dvsi0_xydata3", desc: "Connect port xydata3 from port group dvsi0 to this pad." }
                      { value: "27", name: "port_dvsi0_xydata4", desc: "Connect port xydata4 from port group dvsi0 to this pad." }
                      { value: "28", name: "port_dvsi0_xydata5", desc: "Connect port xydata5 from port group dvsi0 to this pad." }
                      { value: "29", name: "port_dvsi0_xydata6", desc: "Connect port xydata6 from port group dvsi0 to this pad." }
                      { value: "30", name: "port_dvsi0_xydata7", desc: "Connect port xydata7 from port group dvsi0 to this pad." }
                      { value: "31", name: "port_dvsi0_yclk", desc: "Connect port yclk from port group dvsi0 to this pad." }
                      { value: "32", name: "port_dvsi0_ynrst", desc: "Connect port ynrst from port group dvsi0 to this pad." }
                      { value: "33", name: "port_gpio_a_gpio0", desc: "Connect port gpio0 from port group gpio_a to this pad." }
                      { value: "34", name: "port_i2c0_i2c_scl", desc: "Connect port i2c_scl from port group i2c0 to this pad." }
                      { value: "35", name: "port_i2c0_i2c_sda", desc: "Connect port i2c_sda from port group i2c0 to this pad." }
                      { value: "36", name: "port_i2c1_i2c_scl", desc: "Connect port i2c_scl from port group i2c1 to this pad." }
                      { value: "37", name: "port_i2c1_i2c_sda", desc: "Connect port i2c_sda from port group i2c1 to this pad." }
                      { value: "38", name: "port_i2c2_i2c_scl", desc: "Connect port i2c_scl from port group i2c2 to this pad." }
                      { value: "39", name: "port_i2c2_i2c_sda", desc: "Connect port i2c_sda from port group i2c2 to this pad." }
                      { value: "40", name: "port_i2c3_i2c_scl", desc: "Connect port i2c_scl from port group i2c3 to this pad." }
                      { value: "41", name: "port_i2c3_i2c_sda", desc: "Connect port i2c_sda from port group i2c3 to this pad." }
                      { value: "42", name: "port_uart0_rx", desc: "Connect port rx from port group uart0 to this pad." }
                      { value: "43", name: "port_uart0_tx", desc: "Connect port tx from port group uart0 to this pad." }
                      { value: "44", name: "port_uart1_rx", desc: "Connect port rx from port group uart1 to this pad." }
                      { value: "45", name: "port_uart1_tx", desc: "Connect port tx from port group uart1 to this pad." }
                  ]
              }
          ]
      }

