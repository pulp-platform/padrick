      {
          name: PAD_GPIOB15_CFG
          desc: '''
            Pad signal configuration.
          '''
          swaccess: "rw"
          fields: [
            {
                bits: "0"
                name: chip2pad
                desc: '''
                     The signal that connects to the pads TX driver
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "2:1"
                name: drv
                desc: '''
                     Driving strength selector
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "3"
            },
            {
                bits: "3"
                name: pde
                desc: '''
                     Pull down resistor enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "4"
                name: pue
                desc: '''
                     Pull up resistor enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "5"
                name: rxe
                desc: '''
                     Active high RX driver enable 
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "1"
            },
            {
                bits: "6"
                name: slw
                desc: '''
                     
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "7"
                name: smt
                desc: '''
                     Schmit trigger enable
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "0"
            },
            {
                bits: "8"
                name: trie
                desc: '''
                      Active high tri-state enable (active low TX driver enable)
                '''
                swaccess: "rw"
                hwaccess: "hro"
                resval: "1"
            },
          ]
      }

       {
          name: PAD_GPIOB15_MUX_SEL
          desc: '''
              Pad signal port multiplex selection for pad pad_gpiob15. The programmed value defines which port
              is connected to the pad.
          '''
          swaccess: "rw"
          hwaccess: "hro"
          resval: 0
          fields: [
              {
                  name: sel
                  desc: "Port selection index for pad pad_gpiob15."
                  bits: "5:0"
                  enum: [
                      { value: "0", name: "register", desc: "Connects the Pad to the internal configuration register."}
                      { value: "1", name: "port_gpio_b_gpio15", desc: "Connect port gpio15 from port group gpio_b to this pad." }
                      { value: "2", name: "port_qspi0_spi_csn0", desc: "Connect port spi_csn0 from port group qspi0 to this pad." }
